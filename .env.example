# ATENÇÃO: não coloque comentários na mesma linha de um valor.
# O Docker Compose lê "CHAVE=   # texto" como CHAVE="# texto".

# Postgres (DB_HOST é o nome do serviço no docker-compose.yml)
DB_NAME=shortner
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
# obrigatório: defina uma senha
DB_PASSWORD=

# Porta da API dentro da rede do compose (também publicada no host)
APP_PORT=8000

# Porta do nginx no host (padrão 80)
PROXY_PORT=80

# Origem pública das URLs curtas (inclua a porta se PROXY_PORT != 80)
PUBLIC_BASE_URL=http://localhost

# Redis (REDIS_HOST é o nome do serviço no docker-compose.yml)
REDIS_HOST=redis
REDIS_PORT=6379
# obrigatório: defina uma senha
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PROTOCOL=2

# Rate limit: máximo de requisições por janela e duração da janela (minutos)
REQUISITION_LIMIT=1000
MINUTES_OF_DURATION=1

# Custo do bcrypt
HASH_COST=14

# JWT
# obrigatório: segredo de assinatura (ex.: openssl rand -hex 32)
API_KEY=
# tempo de vida do token, em MINUTOS (ver auth/token.go)
TOKEN_LIFE_SPAN=60

# Front-end
WEB_PORT=5173
VITE_API_BASE=/api
